#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <42 43>;
        };
    };
    behaviors {
      lhm: left_hand_homerow_mods {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <115>;
        flavor = "tap-preferred";
        bindings = <&kp>, <&kp>;
        /* hold-trigger-on-release; */
        /* hold-trigger-key-positions = <9 10 11 12 13 14>; */
      };
      rhm: right_hand_homerow_mods {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <115>;
        flavor = "tap-preferred";
        bindings = <&kp>, <&kp>;
        /* hold-trigger-on-release; */
        /* hold-trigger-key-positions = <2 3 4 5 6>; */
      };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
            &kp Q           &kp W           &kp E           &kp R           &kp T                                     &kp Y           &kp U           &kp I           &kp O           &kp P
          &lhm LCTRL A   &lhm LGUI S     &lhm LALT D     &lhm LSHIFT F    &kp G                                       &kp H   &rhm RSHIFT J      &rhm RALT K      &rhm RGUI L     &rhm RCTRL SEMI
            &kp Z   &kp X     &kp C     &kp V      &kp B                                                              &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH
                                                                                  &mo 1   &kp ENTER     &kp SPACE   &mo 2
            >;
        };

        lower_layer {

            bindings = <
&kp N1     &kp N2        &kp N3       &kp N4    &kp N5                             &kp N6     &kp N7    &kp N8           &kp N9     &kp N0    
&kp EXCL   &kp AT        &kp HASH     &kp DLLR  &kp PRCNT                          &kp CARET  &kp AMPS  &kp KP_MULTIPLY  &kp LPAR   &kp RPAR  
&kp EQUAL  &kp MINUS     &kp KP_PLUS  &kp LBRC  &kp RBRC                          &kp LBKT   &kp RBKT  &kp SEMI         &kp COLON  &kp BSLH  
                                          &trans    &trans                        &kp ENTER    &kp SPACE  
            >;
        };
        raise_layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                          &trans     &trans    &trans  &sys_reset &trans
&kp INS       &kp PSCRN     &kp K_CMENU   &trans        &out OUT_TOG                          &kp PG_UP  &studio_unlock    &trans  &kp BSPC
&kp LALT      &kp LCTRL     &kp LSHFT     &trans        &kp CLCK                              &kp LEFT   &kp DOWN  &kp UP  &kp RIGHT  &kp DEL
&kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &trans                                &trans     &trans    &trans  &kp SQT     
                                                  &tog 3        &kp ENTER               &kp ENTER  &trans
            >;
        };
        gaming {
            bindings = <
&kp N1  &kp N2    &kp N3    &kp N4     &kp N5                            &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    
&kp Q   &kp Q     &kp W     &kp E      &kp R                             &kp Y   &kp U      &kp I      &kp O     &kp P     
&kp A   &kp A     &kp S     &kp D      &kp F                             &kp H   &rhm RSHIFT J      &rhm RALT K      &rhm RGUI L     &rhm RCTRL SEMI  
&kp Z   &kp Z     &kp X     &kp C      &kp V                              &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH  
                                        &none   &kp SPACE     &kp SPACE   &tog 3   
            >;
    };
};
        };
